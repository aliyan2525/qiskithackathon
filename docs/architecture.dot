digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.35, ranksep=0.45, pad=0.3, bgcolor="white"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#37474f", penwidth=1.2];
  edge  [fontname="Helvetica", fontsize=9, color="#455a64", arrowsize=0.7];

  subgraph cluster_domain {
    label="1. Domain layer (Energy & Smart Infrastructure)"; style="rounded,dashed"; color="#90a4ae"; fontcolor="#37474f";
    D [fillcolor="#eceff1", label="2 EVs x 3 overnight slots (6 binary variables)\nTariff/urgency  c = [8, 2, 4, 7, 2, 5]\nThermal stress  f = 12 x_A1 x_B1 + 10 x_A2 x_B2 + 8 x_A3 x_B3\nSoC equalities  sum(x_A) = 2,  sum(x_B) = 2"];
  }

  subgraph cluster_enc {
    label="2. Quantum encoding layer"; style="rounded,dashed"; color="#90a4ae"; fontcolor="#37474f";
    E1 [fillcolor="#e3f2fd", label="Penalty QUBO  (P = 25)\nIsing H_P: 6 Z + 9 ZZ terms"];
    E2 [fillcolor="#e3f2fd", label="Objective-only Ising H_C\n(no penalty; used as cost layer)"];
    C  [fillcolor="#fff8e1", label="Encoding check: Ising diagonal == brute-force energy\nfor all 64 basis states (asserted)"];
  }

  subgraph cluster_hyb {
    label="3. Hybrid variational loop (Qiskit V2 primitives)"; style="rounded,dashed"; color="#90a4ae"; fontcolor="#37474f";
    A [fillcolor="#e8f5e9", label="A. Penalty QAOA\nQAOAAnsatz(H_P, p), start |+>^6\nconstraints enforced by penalty"];
    B [fillcolor="#e8f5e9", label="B. Constraint-preserving QAOA\nstart |011011> (feasible), cost layer H_C,\nXY-ring mixers inside each EV register"];
    O [fillcolor="#fff3e0", label="COBYLA (scipy, 5 multi-starts)\n<->  StatevectorEstimator  <expectation>"];
    S [fillcolor="#fff3e0", label="StatevectorSampler (8192 shots) -> bitstring distribution"];
  }

  subgraph cluster_val {
    label="4. Validation and classical benchmarking"; style="rounded,dashed"; color="#90a4ae"; fontcolor="#37474f";
    V1 [fillcolor="#f3e5f5", label="64-state brute force\n+ NumPyMinimumEigensolver (asserted equal)"];
    V2 [fillcolor="#f3e5f5", label="Greedy tariff-only baseline (cost 31)"];
    V3 [fillcolor="#f3e5f5", label="Penalty sweep + exact feasibility threshold\nPareto frontier + weighted-sum weight sweep"];
    V4 [fillcolor="#f3e5f5", label="NISQ transpilation: all-to-all vs linear coupling map"];
  }

  R [shape=note, fillcolor="#ffffff", label="results/results.json  ->  charts/*.png  ->  report/*.docx"];

  D -> E1; D -> E2; E1 -> C [style=dashed, arrowhead=none];
  E1 -> A; E2 -> B; C -> V1 [style=dashed];
  A -> O [dir=both, label=" COBYLA updates (gamma, beta)"];
  B -> O [dir=both];
  O -> S;
  S -> V4 [style=dashed];
  D -> V1 [style=dashed, label=" reference"]; V1 -> V2 [style=invis]; V2 -> V3 [style=invis];
  V3 -> R; S -> R; V4 -> R;
}
